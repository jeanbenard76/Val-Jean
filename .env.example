# ADMIN_TOKEN: Obligatoire en production. Protège les routes admin
# (/api/admin/*, /api/rsvps, POST /api/registry).
# Accès au dashboard : https://votre-domaine.fr/?admin=<ADMIN_TOKEN>
# Générer un token fort : openssl rand -hex 24
ADMIN_TOKEN="CHANGEZ_MOI_TOKEN_LONG_ET_ALEATOIRE"

# DB_PATH: Chemin du fichier SQLite. Sur Coolify, pointer vers le volume
# persistant (ex. /data/wedding.db). Par défaut : ./wedding.db
DB_PATH="/data/wedding.db"

# EMAIL_ADDRESS / EMAIL_PASSWORD: compte mail Infomaniak (@etik.com) utilisé en SMTP
# pour envoyer les notifications aux mariés et les confirmations aux invités.
# EMAIL_PASSWORD = mot de passe d'application (Manager Infomaniak → Service Mail →
# l'adresse → Appareils → Ajouter un appareil), jamais le mot de passe principal.
EMAIL_ADDRESS=""
EMAIL_PASSWORD=""

# VITE_REAL_REGISTRY_URL: URL externe de la liste de mariage
VITE_REAL_REGISTRY_URL="https://liste.zankyou.com/fr/valentine-et-jean-2027"
